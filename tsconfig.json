{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "types": ["node", "vite/client"]
  },
  "include": [
    "server/**/*.ts",
    "shared/**/*.ts",
    "client/**/*.ts",
    "tests/**/*.ts",
    "eslint.config.ts"
  ]
}
